  "videos": [
    {
      "name": "s1_01.mp4",
      "scenario": "S1",
      "title": "Цех: рабочие заходят за ограничительную ленту",
      "segments": [
        {
          "source": "intel_worker_zone",
          "ss": 0,
          "to": 60
        }
      ],
      "frame_step_s": 2.5,
      "description": "Статичная камера сверху-сбоку, пустой цех с колоннами, на полу красная разметка и жёлто-чёрная ограничительная лента. По очереди проходят 1–2 рабочих в касках и жилетах, один стоит за лентой ~11 с.",
      "persons": "1–2 человека, высота фигуры 0.4–0.7 кадра; все в касках и жилетах",
      "rules_to_enable": [
        "zone_intrusion",
        "ppe_missing"
      ],
      "zones": [
        {
          "zone_id": "behind_tape",
          "name": "За ограничительной лентой (левый передний сектор)",
          "kind": "danger",
          "polygon": [
            [
              0.0,
              0.3
            ],
            [
              0.07,
              0.31
            ],
            [
              0.4,
              0.7
            ],
            [
              0.22,
              1.0
            ],
            [
              0.0,
              1.0
            ]
          ],
          "reference_frame_s": 11.1,
          "rationale": "Кадр 11.1 с, цех пуст. Жёлто-чёрная лента идёт по полу от (0.22, 1.0) к основанию колонны (0.525, 0.48); красная линия разметки идёт от (0.07, 0.31) и пересекает ленту в (0.40, 0.70). Зона — сектор слева от ленты и ниже красной линии. Проверка — по точке опоры (низ-центр рамки)."
        }
      ],
      "events": [
        {
          "type": "zone_intrusion",
          "t_start": 15.4,
          "t_end": 26.6,
          "uncertain": false,
          "note": "Рабочий переходит ленту и ~11 с стоит за ней; точка опоры ≈ (0.25, 0.78)"
        },
        {
          "type": "zone_intrusion",
          "t_start": 36.2,
          "t_end": 39.6,
          "uncertain": false,
          "note": "Двое идут вдоль ленты; женщина (светлые волосы, жилет) проходит через зону, опора ≈ (0.21–0.31, 0.75–0.91)"
        },
        {
          "type": "zone_intrusion",
          "t_start": 50.2,
          "t_end": 51.8,
          "uncertain": true,
          "note": "Рабочий срезает угол зоны за ~1.5 с, опора ≈ (0.22–0.33, 0.65–0.90); короче обычного min_duration"
        }
      ]
    },
    {
      "name": "s1_02.mp4",
      "scenario": "S1",
      "title": "Проход между стеллажами: люди заходят в дальний конец прохода",
      "segments": [
        {
          "source": "intel_store_aisle",
          "ss": 0,
          "to": 60
        }
      ],
      "frame_step_s": 2.5,
      "description": "Статичная камера над проходом магазина посуды: два прохода между стеллажами и островной выкладкой. С 9 с в кадре 2–6 человек, есть перекрытия. Разрешение источника 720×404 (не увеличивали).",
      "persons": "2–6 человек, высота фигуры 0.2–0.7 кадра; перекрытия, присевшие люди",
      "rules_to_enable": [
        "zone_intrusion"
      ],
      "zones": [
        {
          "zone_id": "aisle_far_right",
          "name": "Дальний конец правого прохода (условная зона штабелирования)",
          "kind": "danger",
          "polygon": [
            [
              0.47,
              0.22
            ],
            [
              0.6,
              0.22
            ],
            [
              0.75,
              0.56
            ],
            [
              0.5,
              0.56
            ]
          ],
          "reference_frame_s": 3.0,
          "rationale": "Кадр 3 с, проход пуст. Пол правого прохода между правым краем островной выкладки (левая граница) и основанием правого стеллажа (правая граница), от y = 0.56 до дальнего конца прохода."
        }
      ],
      "events": [
        {
          "type": "zone_intrusion",
          "t_start": 22.5,
          "t_end": 25.5,
          "uncertain": true,
          "note": "Мужчина в шляпе и женщина в оранжевом заходят в дальний конец прохода; ноги перекрыты"
        },
        {
          "type": "zone_intrusion",
          "t_start": 26.8,
          "t_end": 47.0,
          "uncertain": false,
          "note": "Женщина в серой кофте (рыжие волосы) стоит в дальнем конце прохода и берёт посуду, опора ≈ (0.55–0.62, 0.30–0.50)"
        },
        {
          "type": "zone_intrusion",
          "t_start": 38.0,
          "t_end": 45.0,
          "uncertain": true,
          "note": "Вторая покупательница присела у правого стеллажа на границе зоны, перекрыта"
        },
        {
          "type": "zone_intrusion",
          "t_start": 48.0,
          "t_end": 60.0,
          "uncertain": false,
          "note": "Женщина в коричневом пальто проходит в дальний конец прохода и остаётся там, опора ≈ (0.53–0.58, 0.40–0.45)"
        }
      ]
    },
    {
      "name": "s2_01.mp4",
      "scenario": "S2",
      "title": "Коридор: люди в касках и жилетах и без них",
      "segments": [
        {
          "source": "intel_safety_gear",
          "ss": 0,
          "to": 60
        }
      ],
      "frame_step_s": 2.5,
      "description": "Статичная камера в коридоре, люди идут к камере. Нарушители: женщина в чёрном без каски и жилета, девушка в жилете без каски; мужчина в чёрном в каске, но без жилета. Остальные полностью в СИЗ.",
      "persons": "1–3 человека, высота фигуры 0.3–0.7 кадра",
      "rules_to_enable": [
        "ppe_missing"
      ],
      "events": [
        {
          "type": "ppe_missing",
          "t_start": 18.0,
          "t_end": 25.0,
          "uncertain": false,
          "note": "Женщина в чёрной футболке: нет каски и жилета; идёт слева рядом с мужчиной в каске и жилете"
        },
        {
          "type": "ppe_missing",
          "t_start": 37.5,
          "t_end": 46.5,
          "uncertain": false,
          "note": "Девушка справа в группе из трёх: жилет есть, каски нет"
        },
        {
          "type": "ppe_missing",
          "t_start": 37.5,
          "t_end": 46.5,
          "uncertain": true,
          "note": "Мужчина в чёрном в центре группы: каска есть, жилета нет (нарушение только по жилету)"
        }
      ]
    },
    {
